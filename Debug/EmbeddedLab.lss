void UART_Init(unsigned int ubrr) {
    // Configurar dirección de pines en el PUERTO D:
    // PD1 (TXD0) como SALIDA (1)
    // PD0 (RXD0) como ENTRADA (0)
    DDRD |= (1 << DDD1);   // TXD0 como salida
